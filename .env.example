# ThermalTrace Environment Configuration Template
# Copy to backend/.env for local backend development or root .env for Docker Compose deployment

# 1. Database Configuration (Supabase PostgreSQL / PostGIS)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:6543/<database>
DATABASE_URL_DIRECT=postgresql+asyncpg://<username>:<password>@<host>:5432/<database>

# 2. Redis Infrastructure Configuration
# Local non-Docker: redis://localhost:6379/0
# Docker Compose:   redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# 3. External API Credentials (Backend Only — Never expose to frontend/git)
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# 4. NASA FIRMS Ingestion Settings
FIRMS_INGESTION_DAYS=5
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
FIRMS_SYNC_INTERVAL_HOURS=6

# 5. Environment & CORS Settings
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# 6. Frontend Build & Basemap Settings (Defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
# VITE_ARCGIS_API_KEY=your_optional_arcgis_api_key_here
