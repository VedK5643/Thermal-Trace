# Supabase PostgreSQL connection (Session Pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres

# Direct connection for migrations (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<DIRECT_HOST>:5432/postgres

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Environment
ENVIRONMENT=development

# NASA FIRMS Map Key — obtain from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# Number of past days per FIRMS ingestion request (1–10, NASA API limit)
# Phase 5D default: 5 days for broader temporal coverage
FIRMS_INGESTION_DAYS=5

FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT

# Automatic FIRMS ingestion synchronization cadence (hours) & stale status threshold (hours)
FIRMS_SYNC_INTERVAL_HOURS=6
FIRMS_STALE_THRESHOLD_HOURS=12

# LLM Intelligence Assistant Settings (Backend Only)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase JWT Secret for token verification
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Redis Infrastructure Configuration
REDIS_URL=redis://localhost:6379/0

# Supabase Storage Credentials (Backend only, never expose frontend!)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
